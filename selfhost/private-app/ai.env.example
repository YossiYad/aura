# Optional. Copy to ai.env (git-ignored) only if you want a shared "house" key.
#
# Normally each listener hands their own key over from Settings -> Daily prep, and the
# nightly mix is built with their key. What is set here is a fallback for anyone who has
# not done that. Leaving this file out entirely is a perfectly good way to run the server.
#
# Comma- or space-separated for more than one key. Gemini keys are tried first, Groq only
# once all of them have failed.
GEMINI_KEYS=
GROQ_KEYS=

# Optional - the defaults match what the app uses on a device.
#GEMINI_MODEL=gemini-2.5-flash
#GROQ_MODEL=openai/gpt-oss-120b
