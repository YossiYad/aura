# Copy to oauth.env and replace each placeholder before running setup.sh.
# Create a Google OAuth client of type Web application with redirect URI:
# https://music.example.com/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=YOUR_RANDOM_COOKIE_SECRET
